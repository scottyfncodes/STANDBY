# STANDBY runs fully without any keys. Climate data uses Open-Meteo (free, no key);
# schedules and load factors come from bundled US DOT/BTS history.

# Optional: live published schedules and status from AeroDataBox (server-side only).
# Get a key from API.Market (https://api.market/store/aedbx/aerodatabox) or RapidAPI.
# AERODATABOX_API_KEY=
# AERODATABOX_MARKETPLACE=apimarket   # or: rapidapi
# AERODATABOX_MAX_DAYS_AHEAD=30       # only fetch live schedules this far ahead

# Not implemented:
# DUFFEL_ACCESS_TOKEN=   # public fares & seat offers (NOT standby availability)
